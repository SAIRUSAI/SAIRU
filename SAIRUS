// ---------- उँगली दबाकर शब्द चुनना + नीले हैंडल खींचकर बढ़ाना (S ड्रैगन वाला डिब्बा) ----------
const hl=window.Highlight?new Highlight():null;if(hl)CSS.highlights.set('sel',hl);
function setSel(r){if(hl){hl.clear();if(r)hl.add(r)}}
let selR=null,selHost=null;
const H=[$('#hs'),$('#he')];
const isD=c=>/[\s।,.?!:;()\-—"'“”‘’…]/.test(c);
function wordB(node,off,dir){const tx=node.textContent;let i=off;
  if(dir<0){while(i>0&&!isD(tx[i-1]))i--}else{while(i<tx.length&&!isD(tx[i]))i++}return i}
// उँगली के पास का अक्षर ढूँढना
function caretAt(x,y,root){
  const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let best=null,bd=1e9,n;
  const r=document.createRange();
  while(n=w.nextNode()){
    r.selectNodeContents(n);const nb=r.getBoundingClientRect();
    if(y<nb.top-40||y>nb.bottom+40)continue;
    const tx=n.textContent;
    for(let i=0;i<tx.length;i++){
      r.setStart(n,i);r.setEnd(n,i+1);const b=r.getBoundingClientRect();
      if(!b.width&&!b.height)continue;
      const dy=y<b.top?b.top-y:y>b.bottom?y-b.bottom:0,dx=x<b.left?b.left-x:x>b.right?x-b.right:0,d=dy*6+dx;
      if(d<bd){bd=d;best={n,o:x<(b.left+b.right)/2?i:i+1}}
    }
  }
  return best;
}
function posH(){
  const rs=selR?selR.getClientRects():[];
  if(!rs.length){H.forEach(h=>h.style.display='none');return}
  const a=rs[0],b=rs[rs.length-1];
  H.forEach(h=>h.style.display='block');
  H[0].style.left=(a.left-22)+'px';H[0].style.top=a.bottom+'px';
  H[1].style.left=b.right+'px';H[1].style.top=b.bottom+'px';
}
function clearSel(){hideTb();setSel(null);selR=null;posH()}
function showSelTb(){
  const T=()=>selR.toString().trim(),host=selHost;
  showTb([
    {t:'अनुवाद',fn:async()=>toast(await API.translate(T()))},
    {t:'कॉपी',fn:()=>{cpy(T());clearSel()}},
    {t:'सब चुनें',fn:()=>{const a=document.createRange();a.selectNodeContents(host);pickRange(a,host)}},
    {t:'वेब खोज',fn:()=>{const t=T();clearSel();q.value=t;upd();q.focus()}},
    {ic:'dots',fn:()=>toast('और विकल्प यहाँ जुड़ेंगे')}
  ],selR.getBoundingClientRect());
}
function pickRange(r,host){selR=r;selHost=host;setSel(r);posH();showSelTb()}
H.forEach((h,i)=>{
  h.onpointerdown=e=>{e.preventDefault();h.setPointerCapture(e.pointerId);h._d=true;hideTb()};
  h.onpointermove=e=>{if(!h._d||!selR)return;
    const c=caretAt(e.clientX,e.clientY-30,selHost);if(!c)return;
    const pr=document.createRange();
    if(i==0){const o=wordB(c.n,c.o,-1);pr.setStart(selR.endContainer,selR.endOffset);pr.collapse(true);if(pr.comparePoint(c.n,o)<=0)selR.setStart(c.n,o)}
    else{const o=wordB(c.n,c.o,1);pr.setStart(selR.startContainer,selR.startOffset);pr.collapse(true);if(pr.comparePoint(c.n,o)>=0)selR.setEnd(c.n,o)}
    setSel(selR);posH()};
  h.onpointerup=h.onpointercancel=()=>{if(!h._d)return;h._d=false;if(selR)showSelTb()};
});
let lpT=null,lpX=0,lpY=0,lpAt=0;
chat.addEventListener('pointerdown',e=>{
  const blk=e.target.closest('.ans p,.ans li,.ans h3,.ut');if(!blk)return;
