  listenLive(onText,onEnd){
    // >>> चाहें तो यहाँ बेहतर speech-to-text API जोड़ें (लगातार चलने वाली) <<<
    const S=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!S){onEnd('unsupported');return {stop(){}}}
    const r=new S();r.lang='hi-IN';r.continuous=true;r.interimResults=true;
    r.onresult=e=>{let t='';for(const x of e.results)t+=x[0].transcript;onText(t.trim())};
    r.onerror=()=>onEnd('error');r.onend=()=>onEnd('end');
    try{r.start()}catch(e){onEnd('error')}
