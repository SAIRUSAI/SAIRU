const R=[[9,16,'9:16 (रील / शॉर्ट्स)'],[1,1,'1:1 (चौकोर)'],[16,9,'16:9 (चौड़ा)'],[4,5,'4:5 (पोस्ट)']];
function draw(c,w,h){c.width=w;c.height=h;const x=c.getContext('2d');x.fillStyle='#050816';x.fillRect(0,0,w,h);
  for(let i=0;i<220;i++){x.fillStyle='rgba(255,255,255,'+Math.random()+')';x.fillRect(Math.random()*w,Math.random()*h,2,2)}
  const cx=w/2,cy=h/2,r=Math.min(w,h)*.2,g=x.createRadialGradient(cx,cy,r*.9,cx,cy,r*2.3);
