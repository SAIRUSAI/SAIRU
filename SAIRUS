const esc=s=>s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const plain=t=>t.replace(/==|\*\*/g,'').replace(/^#+\s*/gm,'');
const inl=s=>esc(s).replace(/\*\*(.+?)\*\*/g,'<b>$1</b>').replace(/==(.+?)==/g,'<mark>$1</mark>');
function mdr(t){let o='',ul=false;for(const l of t.split('\n')){const x=l.trim();
  if(/^[-•]\s/.test(x)){if(!ul){o+='<ul>';ul=true}o+='<li>'+inl(x.slice(2))+'</li>';continue}
  if(ul){o+='</ul>';ul=false}
  if(!x)continue;
  o+=/^#+\s/.test(x)?'<h3>'+inl(x.replace(/^#+\s*/,''))+'</h3>':'<p>'+inl(x)+'</p>'}
  return o+(ul?'</ul>':'')}
