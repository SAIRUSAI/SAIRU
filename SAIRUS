async function send(){
  const t=q.value.trim(),a=att;if(!t&&!a)return;try{speechSynthesis.cancel()}catch(e){}clearSel();HOOKS.beforeSend(t,a);
  started=true;
  const u=document.createElement('div');u.className='u cl';u._t=t;u.innerHTML=(a?`<img src="${a}" alt="">`:'')+`<div class="ur"><div class="ut">${esc(t)}</div><button class="chv" aria-label="पूरा दिखाइए" data-ic="chv" data-s="22"></button></div>`;fi(u);chat.appendChild(u);requestAnimationFrame(()=>{const x=u.querySelector('.ut');if(x.scrollHeight>x.clientHeight+2)u.classList.add('tr');else u.classList.remove('cl')});
  addH(t||'(फोटो)');q.value='';att=null;chip();upd();q.blur();
  chat.scrollTop=chat.scrollHeight;lastY=chat.scrollTop;
  const k=kind(t);k=='text'?await showText(t,a):await showMedia(k,t);
