async function showText(t,a){
  const d=document.createElement('div');d.className='ans';d.innerHTML=LOADER;chat.appendChild(d);
  const txt=await API.askText(t,a);
  d.innerHTML=`<h4><span>★ AI Overview</span><button aria-label="सुनिए" data-ic="spk" data-s="24"></button></h4>`+mdr(txt)+actRow();d._txt=plain(txt);
  fi(d);d.querySelector('h4 button').onclick=()=>{try{if(speechSynthesis.speaking){speechSynthesis.cancel();return}}catch(e){}toast('पढ़कर सुना रहा हूँ');API.speak(spoken(txt))};
  const end=document.createElement('div');end.style.height='1px';chat.appendChild(end);
  const io=new IntersectionObserver(async es=>{if(es[0].isIntersecting){io.disconnect();const ad=document.createElement('div');ad.innerHTML=adHtml(await API.ad('text_end'));chat.insertBefore(ad,end)}},{root:chat});
  io.observe(end);API.speak(spoken(txt));HOOKS.afterAnswer(txt);
}

