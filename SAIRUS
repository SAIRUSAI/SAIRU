  lpT=setTimeout(()=>{const host=blk.closest('.ans')||blk.closest('.u');const c=caretAt(lpX,lpY,blk);if(!c)return;
    lpAt=Date.now();const r=document.createRange();r.setStart(c.n,wordB(c.n,c.o,-1));r.setEnd(c.n,wordB(c.n,c.o,1));
    if(r.collapsed)r.selectNodeContents(blk);pickRange(r,host)},450)});
