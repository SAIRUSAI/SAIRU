const spoken=t=>{const m=[...t.matchAll(/==(.+?)==/g)].map(a=>a[1]);return plain(m.length?m.join(' '):(t.split('\n').find(l=>l.trim()&&!/^#/.test(l.trim()))||t))};
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),2400)}

